"use client";

import { useEffect, useState } from "react";
import { supabase } from "../../lib/supabase";

type Employee = {
  id: string;
  full_name: string;
  role: string;
  employment_type: "full_time" | "part_time" | string;
};

type Schedule = {
  id: string;
  employee_id: string;
  work_date: string;
  start_time: string | null;
  end_time: string | null;
};

type Attendance = {
  id: string;
  employee_id: string;
  work_date: string;
  check_in: string | null;
  check_out: string | null;
  late_minutes: number | null;
  makeup_minutes: number | null;
  penalty_amount: number | null;
  status: string | null;
};

function getVietnamDateString(date = new Date()) {
  return new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Ho_Chi_Minh",
  }).format(date);
}

function getMonthRange() {
  const now = new Date();

  const vietnam = new Date(
    now.toLocaleString("en-US", {
      timeZone: "Asia/Ho_Chi_Minh",
    })
  );

  const year = vietnam.getFullYear();
  const month = vietnam.getMonth();

  const start = new Date(year, month, 1);
  const end = new Date(year, month + 1, 0);

  const formatDate = (date: Date) => {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, "0");
    const d = String(date.getDate()).padStart(2, "0");

    return `${y}-${m}-${d}`;
  };

  return {
    start: formatDate(start),
    end: formatDate(end),
  };
}

function formatTime(value: string | null) {
  if (!value) return "--:--";

  // timestamp
  if (value.includes("T")) {
    return new Intl.DateTimeFormat("vi-VN", {
      timeZone: "Asia/Ho_Chi_Minh",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    }).format(new Date(value));
  }

  // time
  return value.slice(0, 5);
}

function formatDate(value: string) {
  const [year, month, day] = value.split("-");

  return `${day}/${month}/${year}`;
}

function calculateMinutes(
  checkIn: string | null,
  checkOut: string | null
) {
  if (!checkIn || !checkOut) return 0;

  const start = new Date(checkIn).getTime();
  const end = new Date(checkOut).getTime();

  if (end <= start) return 0;

  return Math.floor((end - start) / 60000);
}

// Làm tròn tổng thời gian theo block 15 phút
function roundToQuarterHour(minutes: number) {
  if (minutes <= 0) return 0;

  return Math.round(minutes / 15) * 15;
}

function formatHours(minutes: number) {
  const rounded = roundToQuarterHour(minutes);

  const hours = Math.floor(rounded / 60);
  const mins = rounded % 60;

  if (mins === 0) {
    return `${hours} giờ`;
  }

  return `${hours} giờ ${mins} phút`;
}

function getStatus(
  attendance: Attendance | null
) {
  if (!attendance) return "Chưa check-in";

  if (attendance.check_out) {
    return "Đã check-out";
  }

  if (attendance.check_in) {
    return "Đang làm việc";
  }

  return "Chưa check-in";
}

export default function EmployeePage() {
  const [employee, setEmployee] =
    useState<Employee | null>(null);

  const [schedule, setSchedule] =
    useState<Schedule | null>(null);

  const [attendance, setAttendance] =
    useState<Attendance | null>(null);

  const [monthAttendance, setMonthAttendance] =
    useState<Attendance[]>([]);

  const [loading, setLoading] =
    useState(true);

  const [processing, setProcessing] =
    useState(false);

  const [currentTime, setCurrentTime] =
    useState(new Date());

  async function loadData() {
    setLoading(true);

    try {
      const {
        data: { user },
        error: userError,
      } = await supabase.auth.getUser();

      if (userError || !user) {
        window.location.href = "/login";
        return;
      }

      const {
        data: employeeData,
        error: employeeError,
      } = await supabase
        .from("employees")
        .select(`
          id,
          full_name,
          role,
          employment_type
        `)
        .eq("auth_user_id", user.id)
        .single();

      if (employeeError || !employeeData) {
        alert(
          "Không tìm thấy thông tin nhân viên."
        );
        return;
      }

      // Nếu là admin thì quay về trang quản trị
      if (employeeData.role === "admin") {
        window.location.href = "/";
        return;
      }

      setEmployee(employeeData);

      const today = getVietnamDateString();

      // Lấy ca làm hôm nay
      const {
        data: scheduleData,
        error: scheduleError,
      } = await supabase
        .from("work_schedules")
        .select(`
          id,
          employee_id,
          work_date,
          start_time,
          end_time
        `)
        .eq("employee_id", employeeData.id)
        .eq("work_date", today)
        .maybeSingle();

      if (scheduleError) {
        console.error(scheduleError);
      }

      setSchedule(scheduleData || null);

      // Lấy chấm công hôm nay
      const {
        data: attendanceData,
        error: attendanceError,
      } = await supabase
        .from("attendance")
        .select(`
          id,
          employee_id,
          work_date,
          check_in,
          check_out,
          late_minutes,
          makeup_minutes,
          penalty_amount,
          status
        `)
        .eq("employee_id", employeeData.id)
        .eq("work_date", today)
        .maybeSingle();

      if (attendanceError) {
        console.error(attendanceError);
      }

      setAttendance(attendanceData || null);

      // Lấy chấm công trong tháng
      const range = getMonthRange();

      const {
        data: monthData,
        error: monthError,
      } = await supabase
        .from("attendance")
        .select(`
          id,
          employee_id,
          work_date,
          check_in,
          check_out,
          late_minutes,
          makeup_minutes,
          penalty_amount,
          status
        `)
        .eq("employee_id", employeeData.id)
        .gte("work_date", range.start)
        .lte("work_date", range.end)
        .order("work_date", {
          ascending: false,
        });

      if (monthError) {
        console.error(monthError);
      }

      setMonthAttendance(monthData || []);
    } catch (error) {
      console.error(error);

      alert(
        "Có lỗi khi tải dữ liệu."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadData();

    const timer = setInterval(() => {
      setCurrentTime(new Date());
    }, 1000);

    return () => clearInterval(timer);
  }, []);

  async function handleCheckIn() {
    if (!employee) return;

    if (attendance?.check_in) {
      alert("Bạn đã check-in hôm nay rồi.");
      return;
    }

    setProcessing(true);

    try {
      const now = new Date();
      const today = getVietnamDateString();

      // Nếu có ca thì tính đi muộn dựa trên giờ bắt đầu ca
      let lateMinutes = 0;

      if (schedule?.start_time) {
        const vietnamNow = new Date(
          now.toLocaleString("en-US", {
            timeZone: "Asia/Ho_Chi_Minh",
          })
        );

        const [hour, minute] =
          schedule.start_time
            .slice(0, 5)
            .split(":")
            .map(Number);

        const shiftStart = new Date(vietnamNow);

        shiftStart.setHours(
          hour,
          minute,
          0,
          0
        );

        lateMinutes = Math.max(
          0,
          Math.floor(
            (vietnamNow.getTime() -
              shiftStart.getTime()) /
              60000
          )
        );
      }

      const { error } = await supabase
        .from("attendance")
        .insert({
          employee_id: employee.id,
          work_date: today,
          check_in: now.toISOString(),
          check_out: null,
          late_minutes: lateMinutes,
          makeup_minutes: 0,
          penalty_amount: 0,
          status: "checked_in",
        });

      if (error) {
        console.error(error);

        alert(
          `Không thể check-in: ${error.message}`
        );

        return;
      }

      alert("Check-in thành công.");

      await loadData();
    } catch (error) {
      console.error(error);

      alert("Có lỗi khi check-in.");
    } finally {
      setProcessing(false);
    }
  }

  async function handleCheckOut() {
    if (!attendance) {
      alert("Bạn chưa check-in.");
      return;
    }

    if (!attendance.check_in) {
      alert("Bạn chưa check-in.");
      return;
    }

    if (attendance.check_out) {
      alert("Bạn đã check-out hôm nay rồi.");
      return;
    }

    setProcessing(true);

    try {
      const now = new Date();

      const { error } = await supabase
        .from("attendance")
        .update({
          check_out: now.toISOString(),
          status: "checked_out",
        })
        .eq("id", attendance.id);

      if (error) {
        console.error(error);

        alert(
          `Không thể check-out: ${error.message}`
        );

        return;
      }

      alert("Check-out thành công.");

      await loadData();
    } catch (error) {
      console.error(error);

      alert("Có lỗi khi check-out.");
    } finally {
      setProcessing(false);
    }
  }

  async function handleLogout() {
    await supabase.auth.signOut();

    window.location.href = "/login";
  }

  const checkedIn =
    Boolean(attendance?.check_in);

  const checkedOut =
    Boolean(attendance?.check_out);

  const todayMinutes = attendance
    ? calculateMinutes(
        attendance.check_in,
        attendance.check_out ||
          (checkedIn
            ? currentTime.toISOString()
            : null)
      )
    : 0;

  const monthMinutes =
    monthAttendance.reduce(
      (total, item) => {
        return (
          total +
          calculateMinutes(
            item.check_in,
            item.check_out
          )
        );
      },
      0
    );

  const vietnamCurrentTime =
    new Intl.DateTimeFormat("vi-VN", {
      timeZone: "Asia/Ho_Chi_Minh",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    }).format(currentTime);

  return (
    <main
      style={{
        minHeight: "100vh",
        background: "#f6f7f5",
        fontFamily:
          "Arial, Helvetica, sans-serif",
        color: "#1f2a24",
      }}
    >
      <div
        style={{
          maxWidth: "700px",
          margin: "0 auto",
          padding:
            "24px 16px 60px",
        }}
      >
        {/* HEADER */}

        <div
          style={{
            display: "flex",
            justifyContent:
              "space-between",
            alignItems: "center",
            marginBottom: "24px",
          }}
        >
          <div>
            <div
              style={{
                fontSize: "13px",
                color: "#708077",
                letterSpacing: "1px",
                marginBottom: "4px",
              }}
            >
              SOBA STAFF
            </div>

            <h1
              style={{
                margin: 0,
                fontSize: "28px",
              }}
            >
              Xin chào,{" "}
              {employee?.full_name ||
                "Nhân viên"} 👋
            </h1>
          </div>

          <button
            onClick={handleLogout}
            style={{
              border:
                "1px solid #d8ddd9",
              background: "#ffffff",
              borderRadius: "10px",
              padding:
                "10px 14px",
              cursor: "pointer",
              fontWeight: 600,
            }}
          >
            Đăng xuất
          </button>
        </div>

        {/* CLOCK */}

        <section
          style={{
            background: "#236b46",
            color: "#ffffff",
            borderRadius: "20px",
            padding: "24px",
            marginBottom: "18px",
          }}
        >
          <div
            style={{
              fontSize: "14px",
              opacity: 0.8,
              marginBottom: "8px",
            }}
          >
            Giờ hiện tại
          </div>

          <div
            style={{
              fontSize: "38px",
              fontWeight: 700,
              letterSpacing: "1px",
            }}
          >
            {vietnamCurrentTime}
          </div>

          <div
            style={{
              marginTop: "10px",
              opacity: 0.9,
              fontSize: "14px",
            }}
          >
            {formatDate(
              getVietnamDateString()
            )}
          </div>
        </section>

        {loading ? (
          <div
            style={{
              background: "#ffffff",
              borderRadius: "18px",
              padding: "30px",
              textAlign: "center",
            }}
          >
            Đang tải dữ liệu...
          </div>
        ) : (
          <>
            {/* THÔNG TIN HÔM NAY */}

            <section
              style={{
                background: "#ffffff",
                borderRadius: "20px",
                padding: "22px",
                marginBottom: "18px",
                boxShadow:
                  "0 4px 18px rgba(0,0,0,0.04)",
              }}
            >
              <h2
                style={{
                  marginTop: 0,
                  fontSize: "20px",
                }}
              >
                Hôm nay
              </h2>

              <div style={rowStyle}>
                <span>Loại nhân viên</span>

                <b>
                  {employee?.employment_type ===
                  "part_time"
                    ? "Part-time"
                    : "Full-time"}
                </b>
              </div>

              <div style={rowStyle}>
                <span>Ca làm</span>

                <b>
                  {schedule
                    ? `${formatTime(
                        schedule.start_time
                      )} - ${formatTime(
                        schedule.end_time
                      )}`
                    : "Chưa có ca được xếp"}
                </b>
              </div>

              <div style={rowStyle}>
                <span>Trạng thái</span>

                <b>
                  {getStatus(attendance)}
                </b>
              </div>

              {checkedIn && (
                <div style={rowStyle}>
                  <span>Check-in</span>

                  <b>
                    {formatTime(
                      attendance?.check_in ||
                        null
                    )}
                  </b>
                </div>
              )}

              {checkedOut && (
                <div style={rowStyle}>
                  <span>Check-out</span>

                  <b>
                    {formatTime(
                      attendance?.check_out ||
                        null
                    )}
                  </b>
                </div>
              )}

              {checkedIn && (
                <div
                  style={{
                    display: "flex",
                    justifyContent:
                      "space-between",
                    paddingTop: "14px",
                    fontSize: "17px",
                  }}
                >
                  <span>Thời gian làm</span>

                  <b
                    style={{
                      color: "#236b46",
                    }}
                  >
                    {formatHours(
                      todayMinutes
                    )}
                  </b>
                </div>
              )}
            </section>

            {/* BUTTON */}

            {!checkedIn ? (
              <button
                onClick={handleCheckIn}
                disabled={processing}
                style={{
                  width: "100%",
                  padding: "18px",
                  border: "none",
                  borderRadius: "16px",
                  background:
                    "#236b46",
                  color: "#ffffff",
                  fontSize: "17px",
                  fontWeight: 700,
                  cursor:
                    processing
                      ? "not-allowed"
                      : "pointer",
                  marginBottom: "18px",
                }}
              >
                {processing
                  ? "ĐANG XỬ LÝ..."
                  : "CHECK-IN"}
              </button>
            ) : !checkedOut ? (
              <button
                onClick={handleCheckOut}
                disabled={processing}
                style={{
                  width: "100%",
                  padding: "18px",
                  border: "none",
                  borderRadius: "16px",
                  background:
                    "#c96b3b",
                  color: "#ffffff",
                  fontSize: "17px",
                  fontWeight: 700,
                  cursor:
                    processing
                      ? "not-allowed"
                      : "pointer",
                  marginBottom: "18px",
                }}
              >
                {processing
                  ? "ĐANG XỬ LÝ..."
                  : "CHECK-OUT"}
              </button>
            ) : (
              <div
                style={{
                  background: "#eaf5ee",
                  color: "#236b46",
                  borderRadius: "16px",
                  padding: "18px",
                  textAlign: "center",
                  fontWeight: 700,
                  marginBottom: "18px",
                }}
              >
                ✓ Bạn đã hoàn thành ca hôm nay
              </div>
            )}

            {/* THỐNG KÊ THÁNG */}

            <section
              style={{
                background: "#ffffff",
                borderRadius: "20px",
                padding: "22px",
                marginBottom: "18px",
              }}
            >
              <h2
                style={{
                  marginTop: 0,
                  fontSize: "20px",
                }}
              >
                Thống kê tháng này
              </h2>

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "1fr 1fr",
                  gap: "14px",
                }}
              >
                <div
                  style={{
                    background:
                      "#f6f7f5",
                    borderRadius: "14px",
                    padding: "16px",
                  }}
                >
                  <div
                    style={{
                      fontSize: "13px",
                      color: "#718077",
                      marginBottom: "8px",
                    }}
                  >
                    Tổng giờ
                  </div>

                  <b
                    style={{
                      fontSize: "20px",
                    }}
                  >
                    {formatHours(
                      monthMinutes
                    )}
                  </b>
                </div>

                <div
                  style={{
                    background:
                      "#f6f7f5",
                    borderRadius: "14px",
                    padding: "16px",
                  }}
                >
                  <div
                    style={{
                      fontSize: "13px",
                      color: "#718077",
                      marginBottom: "8px",
                    }}
                  >
                    Số ngày đã làm
                  </div>

                  <b
                    style={{
                      fontSize: "20px",
                    }}
                  >
                    {
                      monthAttendance.filter(
                        (item) =>
                          item.check_in &&
                          item.check_out
                      ).length
                    }{" "}
                    ngày
                  </b>
                </div>
              </div>

              <p
                style={{
                  fontSize: "13px",
                  color: "#718077",
                  marginBottom: 0,
                  marginTop: "16px",
                }}
              >
                Thời gian làm được làm
                tròn theo block 15 phút.
              </p>
            </section>

            {/* LỊCH SỬ */}

            <section
              style={{
                background: "#ffffff",
                borderRadius: "20px",
                padding: "22px",
              }}
            >
              <h2
                style={{
                  marginTop: 0,
                  fontSize: "20px",
                }}
              >
                Lịch sử chấm công
              </h2>

              {monthAttendance.length ===
              0 ? (
                <p
                  style={{
                    color: "#718077",
                  }}
                >
                  Chưa có dữ liệu chấm
                  công trong tháng.
                </p>
              ) : (
                monthAttendance
                  .slice(0, 10)
                  .map((item) => {
                    const minutes =
                      calculateMinutes(
                        item.check_in,
                        item.check_out
                      );

                    return (
                      <div
                        key={item.id}
                        style={{
                          padding:
                            "14px 0",
                          borderBottom:
                            "1px solid #edf0ee",
                        }}
                      >
                        <div
                          style={{
                            display: "flex",
                            justifyContent:
                              "space-between",
                            marginBottom: "7px",
                          }}
                        >
                          <b>
                            {formatDate(
                              item.work_date
                            )}
                          </b>

                          <b
                            style={{
                              color:
                                item.check_out
                                  ? "#236b46"
                                  : "#c96b3b",
                            }}
                          >
                            {item.check_out
                              ? "Hoàn thành"
                              : "Chưa check-out"}
                          </b>
                        </div>

                        <div
                          style={{
                            fontSize:
                              "14px",
                            color:
                              "#718077",
                            display: "flex",
                            justifyContent:
                              "space-between",
                          }}
                        >
                          <span>
                            {formatTime(
                              item.check_in
                            )}{" "}
                            -{" "}
                            {formatTime(
                              item.check_out
                            )}
                          </span>

                          <span>
                            {item.check_out
                              ? formatHours(
                                  minutes
                                )
                              : ""}
                          </span>
                        </div>
                      </div>
                    );
                  })
              )}
            </section>
          </>
        )}
      </div>
    </main>
  );
}

const rowStyle = {
  display: "flex",
  justifyContent: "space-between",
  gap: "20px",
  padding: "13px 0",
  borderBottom: "1px solid #edf0ee",
  fontSize: "15px",
};
